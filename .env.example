# Required — the admin dashboard stays locked until this is set (8+ chars)
ADMIN_PASSWORD=

# Canonical origin (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://kr8digitals.com

# Optional — email notifications for every form
# RESEND_API_KEY=
# RESEND_FROM="KR8 Digitals <hello@kr8digitals.com>"
# KR8_ADMIN_EMAILS=kr8digitals01@gmail.com

# Optional — flip the datastore from files to Postgres (same interface)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Optional — payments: bank_transfer (default) or paystack
# PAYMENT_PROVIDER=bank_transfer
# PAYSTACK_SECRET_KEY=
# KR8_BANK_NAME=
# KR8_BANK_ACCOUNT_NAME=KR8 Digitals
# KR8_BANK_ACCOUNT=

# Optional — pin any currency rate over the live one, e.g.
# KR8_RATE_OVERRIDES={"NGN":1600}
